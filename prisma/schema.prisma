// prisma/schema.prisma
// TechLibrairie - Schéma de base de données (PostgreSQL / Neon)
// La connexion est lue uniquement depuis la variable d'environnement DATABASE_URL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// ENUMS
// ---------------------------------------------------------------------------

enum Role {
  BUYER
  SELLER
  ADMIN
}

enum SellerStatus {
  ACTIVE
  SUSPENDED
}

enum ProductStatus {
  PUBLISHED
  UNPUBLISHED
  SUSPENDED
  // Ouvrage de l'édition de livres déposé mais pas encore publié : la contribution n'est pas validée
  PENDING_PAYMENT
}

// Service sous lequel un ouvrage est déposé
enum ProductKind {
  // Édition de livres : contribution de participation unique, ISBN et certification des droits
  BOOK_EDITION
  // Vente de PDF : dépôt et vente directe de documents et ressources (cours, rapports, guides...)
  PDF_DOCUMENT
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  CANCELED
  REFUNDED
}

enum PaymentProvider {
  STRIPE
  CINETPAY
}

enum PaymentMethod {
  CARD
  MOBILE_MONEY
  ORANGE_MONEY
  MOOV_MONEY
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELED
  REFUNDED
}

enum PayoutStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
}

enum Currency {
  XOF
  EUR
  USD
}

enum SupportCategory {
  GENERAL
  TECHNICAL
  PAYMENT
  SELLER_ACCOUNT
  OTHER
}

enum ThreadStatus {
  AWAITING_PAYMENT
  OPEN
  ANSWERED
  CLOSED
}

enum ContactStatus {
  NEW
  READ
  ANSWERED
  ARCHIVED
}

enum AdPlacement {
  HOME_TOP
  HOME_MIDDLE
  HOME_BOTTOM
  CATALOGUE_TOP
  CATALOGUE_SIDEBAR
  BOOK_PAGE
  SELLER_DASHBOARD
  DOWNLOAD_CONFIRMATION
  FOOTER_TOP
}

enum AdKind {
  LOCAL_BANNER
  ADSTERRA_BANNER
  ADSTERRA_NATIVE
  ADSTERRA_SCRIPT
  ADSTERRA_DIRECT_LINK
  ADSTERRA_POPUNDER
}

enum ReviewStatus {
  PUBLISHED
  HIDDEN
}

// Type de remise d'un code promotionnel
enum PromoType {
  // Pourcentage du total du panier (value = 1 à 90)
  PERCENT
  // Montant fixe en FCFA (value = multiple de 5)
  FIXED
}

// Qui supporte la remise d'un code promotionnel
enum PromoBearer {
  // Partagée entre la boutique et les vendeurs, proportionnellement
  PROPORTIONAL
  // Supportée par la boutique seule : le vendeur garde son gain normal
  SHOP
}

// Qualité sous laquelle un ouvrage de l'édition de livres est publié
enum PublishingCapacity {
  // L'auteur de l'ouvrage
  AUTHOR
  // Éditeur indépendant (détient les droits de diffusion numérique)
  INDEPENDENT_PUBLISHER
  // Vendeur tiers (diffuse l'ouvrage d'autrui avec son autorisation écrite)
  THIRD_PARTY_SELLER
}

// État du règlement de la contribution de participation d'un ouvrage de l'édition de livres
enum PublicationFeeStatus {
  // La contribution est à régler : l'auteur n'a pas encore déclaré son paiement
  AWAITING_PAYMENT
  // Paiement déclaré par l'auteur : à vérifier par l'administration
  SUBMITTED
  // Paiement vérifié : l'ouvrage est publié
  VALIDATED
  // Paiement non retrouvé ou insuffisant : l'auteur peut déclarer à nouveau
  REJECTED
}

// ---------------------------------------------------------------------------
// UTILISATEURS & AUTHENTIFICATION (compatible Auth.js)
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String?
  // Date du dernier changement de mot de passe : les sessions ouvertes avant cette date sont refusées
  passwordChangedAt DateTime?
  image         String?
  phone         String?
  role          Role      @default(BUYER)
  isActive      Boolean   @default(true)
  // Rappel par email d'une commande non terminée (l'utilisateur peut le désactiver)
  reminderEmails Boolean  @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Double authentification (administrateurs) : la clé est CHIFFRÉE, jamais en clair.
  totpSecretEnc      String?   @db.Text
  // Clé générée mais pas encore confirmée par un premier code valide
  totpPendingEnc     String?   @db.Text
  totpEnabledAt      DateTime?
  // Dernier créneau de 30 secondes accepté (empêche de réutiliser un même code)
  totpLastStep       Int?
  // Empreintes (HMAC) des codes de secours encore utilisables
  totpRecoveryHashes String[]  @default([])

  accounts        Account[]
  sessions        Session[]
  sellerProfile   SellerProfile?
  orders          Order[]
  supportThreads  SupportThread[] @relation("ThreadOwner")
  assignedThreads SupportThread[] @relation("ThreadAssignee")
  sentMessages    Message[]       @relation("MessageSender")
  contactMessages ContactMessage[]
  reviews         Review[]
  favorites       Favorite[]

  @@index([role])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Échecs de connexion récents (limitation des tentatives, voir lib/login-throttle.ts)
model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  // Empreinte de l'adresse IP (jamais l'IP en clair)
  ipHash    String?
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ipHash, createdAt])
}

// Journal des actions d'administration (aucune donnée secrète n'y est enregistrée).
// Pas de relation avec User : l'adresse email est conservée telle quelle pour l'historique.
model AuditLog {
  id         String   @id @default(cuid())
  adminId    String?
  adminEmail String
  // Code d'action, ex. "commande.remboursee"
  action     String
  targetType String?
  targetId   String?
  details    Json?
  // Empreinte de l'adresse IP (jamais l'IP en clair)
  ipHash     String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([adminId, createdAt])
  @@index([action, createdAt])
}

// ---------------------------------------------------------------------------
// VENDEURS : auteurs et éditeurs (profil public du vendeur)
// ---------------------------------------------------------------------------

model SellerProfile {
  id                   String       @id @default(cuid())
  userId               String       @unique
  displayName          String
  slug                 String       @unique
  bio                  String?      @db.Text
  avatarUrl            String?
  status               SellerStatus @default(ACTIVE)

  // Taux de commission spécifique à ce vendeur (en points de base, 1000 = 10 %).
  // Si null, le taux global de PlatformSetting s'applique.
  commissionRateBps    Int?

  // Coordonnées de versement des revenus (Orange Money, Moov Money, banque)
  payoutMobileNumber   String?
  payoutMobileOperator String?
  payoutBankDetails    String?      @db.Text

  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  products Product[]
  items    OrderItem[]
  payouts  Payout[]
}

// ---------------------------------------------------------------------------
// CATALOGUE : catégories et livres / guides PDF (Product = "Book")
// ---------------------------------------------------------------------------

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  createdAt   DateTime @default(now())

  products Product[]
}

model Product {
  id            String        @id @default(cuid())
  sellerId      String
  categoryId    String?
  title         String
  slug          String        @unique
  description   String        @db.Text
  language      String        @default("fr")
  pageCount     Int?

  // Règle métier : les prix sont fixés en FCFA (XOF), sans taxe.
  // XOF : francs entiers (multiples de 5 pour Mobile Money).
  priceAmount   Int
  currency      Currency      @default(XOF)

  coverImageUrl String?

  // Fichier PDF stocké en accès PRIVÉ. Jamais exposé publiquement.
  pdfStorageKey String
  pdfFileName   String
  pdfSizeBytes  Int

  // Service : édition de livres (contribution unique, ISBN, certification BBDA) ou vente de PDF
  // (documents et ressources, sans contribution). Les ouvrages antérieurs sont classés PDF_DOCUMENT.
  kind          ProductKind   @default(PDF_DOCUMENT)

  // Édition : ISBN facultatif (10 ou 13 caractères, sans tirets), qualité du déposant et auteur indiqué.
  // Null pour les ouvrages publiés avant l'ajout de ces champs et pour la vente de PDF (sauf l'auteur, facultatif).
  isbn               String?
  publishingCapacity PublishingCapacity?
  authorName         String?

  // Certification des droits cochée par le déposant : date et texte exact accepté.
  // Null pour les ouvrages publiés avant l'ajout de la certification.
  rightsCertifiedAt       DateTime?
  rightsCertificationText String?   @db.Text

  // Publication immédiate pour la vente de PDF ; PENDING_PAYMENT pour un ouvrage de l'édition
  // tant que la contribution de participation n'est pas validée par l'administration.
  status        ProductStatus @default(PUBLISHED)
  publishedAt   DateTime      @default(now())

  salesCount    Int           @default(0)

  // Note moyenne et nombre d'avis publiés (recalculés à chaque changement d'avis)
  ratingAverage Float         @default(0)
  ratingCount   Int           @default(0)

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  seller         SellerProfile   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  category       Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  items          OrderItem[]
  reviews        Review[]
  favorites      Favorite[]
  publicationFee PublicationFee?

  @@index([sellerId])
  @@index([categoryId])
  @@index([status, publishedAt])
  @@index([kind, status])
  @@index([isbn])
}

// Contribution de participation (soutien technique et hébergement du site) d'un ouvrage de l'édition
// de livres. Elle est indépendante des ventes : aucune commission ni redevance n'en dépend.
// Un seul enregistrement par ouvrage ; le montant est figé au dépôt.
model PublicationFee {
  id               String               @id @default(cuid())
  productId        String               @unique
  // Montant en FCFA
  amountXof        Int
  status           PublicationFeeStatus @default(AWAITING_PAYMENT)

  // Paiement déclaré par l'auteur
  // Moyen : ORANGE_MONEY ou MOOV_MONEY
  method           String?
  payerPhone       String?
  // Référence de la transaction Mobile Money (unique : une référence ne sert qu'une fois)
  paymentReference String?              @unique
  submittedAt      DateTime?

  // Décision de l'administration
  validatedAt      DateTime?
  validatedBy      String?
  rejectionReason  String?

  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([status, submittedAt])
  @@index([status, createdAt])
}

// Ressources gratuites : PDF publiés par l'administration, téléchargeables après une attente
// de 30 secondes avec publicité (voir lib/free-resources.ts). Le PDF est stocké en accès PRIVÉ.
model FreeResource {
  id            String   @id @default(cuid())
  title         String
  slug          String   @unique
  description   String   @db.Text
  language      String   @default("fr")
  pageCount     Int?
  coverImageUrl String?

  pdfStorageKey String
  pdfFileName   String
  pdfSizeBytes  Int

  isActive      Boolean  @default(true)
  downloadCount Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([isActive, createdAt])
}

// Avis des acheteurs sur un ouvrage (un seul par acheteur et par ouvrage)
model Review {
  id        String       @id @default(cuid())
  productId String
  userId    String
  // Note de 1 à 5
  rating    Int
  comment   String?      @db.Text
  status    ReviewStatus @default(PUBLISHED)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([productId, userId])
  @@index([productId, status, createdAt])
  @@index([userId])
  @@index([status, createdAt])
}

// Ouvrages mis de côté par un utilisateur (liste de favoris)
model Favorite {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId, createdAt])
  @@index([productId])
}

// Codes promotionnels créés par l'administration (paniers en FCFA uniquement)
model PromoCode {
  id                String      @id @default(cuid())
  // Code en MAJUSCULES, ex. BIENVENUE10
  code              String      @unique
  description       String?
  type              PromoType
  // PERCENT : 1 à 90 (%) ; FIXED : montant en FCFA (multiple de 5)
  value             Int
  bearer            PromoBearer @default(PROPORTIONAL)
  // Montant minimum d'achat (FCFA, avant remise)
  minOrderAmountXof Int         @default(0)
  startsAt          DateTime?
  endsAt            DateTime?
  // Nombre total d'utilisations autorisées (null = illimité)
  maxRedemptions    Int?
  // Nombre d'utilisations par acheteur
  maxPerUser        Int         @default(1)
  isActive          Boolean     @default(true)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  orders Order[]

  @@index([isActive, endsAt])
}

// ---------------------------------------------------------------------------
// COMMANDES (aucune taxe sur les produits numériques)
// ---------------------------------------------------------------------------

model Order {
  id          String      @id @default(cuid())
  number      String      @unique
  buyerId     String
  buyerEmail  String
  status      OrderStatus @default(PENDING)

  // Montant réellement à payer = somme des lignes (en FCFA), remise comprise. Aucune taxe ajoutée.
  totalAmount Int
  currency    Currency

  // Code promotionnel utilisé et remise totale accordée (FCFA)
  promoCodeId    String?
  discountAmount Int      @default(0)

  paidAt      DateTime?
  // Date d'envoi du rappel "commande non terminée" (un seul rappel par commande)
  reminderSentAt DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  buyer     User        @relation(fields: [buyerId], references: [id], onDelete: Restrict)
  promoCode PromoCode?  @relation(fields: [promoCodeId], references: [id], onDelete: SetNull)
  items     OrderItem[]
  payments  Payment[]

  @@index([buyerId])
  @@index([status])
  @@index([createdAt])
  @@index([promoCodeId])
}

model OrderItem {
  id                String   @id @default(cuid())
  orderId           String
  productId         String
  sellerId          String

  // Instantané du produit au moment de l'achat.
  // unitAmount = prix réellement payé pour cette ligne (remise déduite).
  productTitle      String
  unitAmount        Int
  currency          Currency

  // Prix catalogue avant remise (null pour les commandes antérieures aux codes promo)
  // et remise appliquée à cette ligne
  listAmount        Int?
  discountAmount    Int      @default(0)

  // Répartition calculée automatiquement à la vente
  commissionRateBps Int
  commissionAmount  Int
  sellerAmount      Int

  createdAt         DateTime @default(now())

  order     Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  seller    SellerProfile   @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  downloads DownloadToken[]

  @@unique([orderId, productId])
  @@index([sellerId])
  @@index([productId])
}

// ---------------------------------------------------------------------------
// PAIEMENTS (CinetPay : Orange Money / Moov Money / cartes ; Stripe : cartes bancaires)
// ---------------------------------------------------------------------------

model Payment {
  id                String          @id @default(cuid())
  orderId           String
  provider          PaymentProvider
  method            PaymentMethod
  status            PaymentStatus   @default(PENDING)

  // Montant réellement débité, dans la devise du paiement
  // (XOF pour le Mobile Money ; EUR/USD en centimes pour la carte convertie).
  amount            Int
  currency          Currency

  // Conversion : montant de référence en FCFA et taux appliqué
  // (nombre de FCFA pour 1 unité de la devise de paiement). Null si paiement en FCFA.
  baseAmountXof     Int?
  exchangeRate      Decimal?        @db.Decimal(18, 6)

  // Identifiant de la transaction chez le prestataire
  // (Stripe : session ; CinetPay : transaction_id)
  providerReference String          @unique
  providerPayload   Json?

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([status])
}

// Taux de change pour convertir les prix en FCFA vers les devises internationales.
// L'historique est conservé ; le taux actif le plus récent est utilisé.
model ExchangeRate {
  id          String   @id @default(cuid())
  currency    Currency
  // Nombre de FCFA pour 1 unité de la devise (ex. EUR : 655.957000)
  xofPerUnit  Decimal  @db.Decimal(18, 6)
  source      String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([currency, isActive, createdAt])
}

// ---------------------------------------------------------------------------
// TÉLÉCHARGEMENT SÉCURISÉ
// ---------------------------------------------------------------------------

model DownloadToken {
  id            String    @id @default(cuid())
  orderItemId   String
  token         String    @unique
  expiresAt     DateTime
  maxDownloads  Int       @default(5)
  downloadCount Int       @default(0)
  lastUsedAt    DateTime?
  createdAt     DateTime  @default(now())

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([orderItemId])
  @@index([expiresAt])
}

 GLOBAUX DE LA PLATEFORME (une seule ligne, id = "global")
// ---------------------------------------------------------------------------

model PlatformSetting {
  id                       String   @id @default("global")

  // Commission par défaut en points de base (1000 = 10 %)
  defaultCommissionRateBps Int      @default(1000)

  // Téléchargement sécurisé
  downloadLinkTtlHours     Int      @default(72)
  downloadMaxAttempts      Int      @default(5)

  // Montant minimal pour demander un versement (en XOF)
  minPayoutAmountXof       Int      @default(5000)

  // Marge appliquée lors de la conversion FCFA vers une devise étrangère
  // (en points de base, 200 = 2 %), pour absorber les variations de change
  fxMarginBps              Int      @default(200)

  // Tarif par défaut d'une conversation de support (en FCFA)
  supportFeeXof            Int      @default(1000)

  // Coordonnées affichées dans le pied de page
  contactEmail             String?
  whatsappNumber           String?

  updatedAt                DateTime @updatedAt
}
