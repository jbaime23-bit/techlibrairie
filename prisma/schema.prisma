// prisma/schema.prisma
// TechLibrairie - Schéma de base de données (PostgreSQL / Neon)
// La connexion est lue uniquement depuis la variable d'environnement DATABASE_URL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// ENUMS
// ---------------------------------------------------------------------------

enum Role {
  BUYER
  SELLER
  ADMIN
}

enum SellerStatus {
  ACTIVE
  SUSPENDED
}

enum ProductStatus {
  PUBLISHED
  UNPUBLISHED
  SUSPENDED
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  CANCELED
  REFUNDED
}

enum PaymentProvider {
  STRIPE
  CINETPAY
}

enum PaymentMethod {
  CARD
  MOBILE_MONEY
  ORANGE_MONEY
  MOOV_MONEY
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELED
  REFUNDED
}

enum PayoutStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
}

enum Currency {
  XOF
  EUR
  USD
}

enum SupportCategory {
  GENERAL
  TECHNICAL
  PAYMENT
  SELLER_ACCOUNT
  OTHER
}

enum ThreadStatus {
  AWAITING_PAYMENT
  OPEN
  ANSWERED
  CLOSED
}

enum ContactStatus {
  NEW
  READ
  ANSWERED
  ARCHIVED
}

enum AdPlacement {
  HOME_TOP
  HOME_MIDDLE
  HOME_BOTTOM
  CATALOGUE_TOP
  CATALOGUE_SIDEBAR
  BOOK_PAGE
  SELLER_DASHBOARD
  DOWNLOAD_CONFIRMATION
  FOOTER_TOP
}

enum AdKind {
  LOCAL_BANNER
  ADSTERRA_BANNER
  ADSTERRA_NATIVE
  ADSTERRA_SCRIPT
  ADSTERRA_DIRECT_LINK
  ADSTERRA_POPUNDER
}

enum ReviewStatus {
  PUBLISHED
  HIDDEN
}

enum PromoType {
  PERCENT
  FIXED
}

enum PromoBearer {
  PROPORTIONAL
  SHOP
}

// ---------------------------------------------------------------------------
// UTILISATEURS & AUTHENTIFICATION (compatible Auth.js)
// ---------------------------------------------------------------------------

model User {
  id                 String    @id @default(cuid())
  name               String?
  email              String    @unique
  emailVerified      DateTime?
  passwordHash       String?
  passwordChangedAt  DateTime?
  image              String?
  phone              String?
  role               Role      @default(BUYER)
  isActive           Boolean   @default(true)
  reminderEmails     Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  totpSecretEnc      String?   @db.Text
  totpPendingEnc     String?   @db.Text
  totpEnabledAt      DateTime?
  totpLastStep       Int?
  totpRecoveryHashes String[]  @default([])

  accounts        Account[]
  sessions        Session[]
  sellerProfile   SellerProfile?
  orders          Order[]
  supportThreads  SupportThread[] @relation("ThreadOwner")
  assignedThreads SupportThread[] @relation("ThreadAssignee")
  sentMessages    Message[]       @relation("MessageSender")
  contactMessages ContactMessage[]
  reviews         Review[]
  favorites       Favorite[]

  @@index([role])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  ipHash    String?
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ipHash, createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  adminId    String?
  adminEmail String
  action     String
  targetType String?
  targetId   String?
  details    Json?
  ipHash     String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([adminId, createdAt])
  @@index([action, createdAt])
}

// ---------------------------------------------------------------------------
// VENDEURS : auteurs et éditeurs (profil public du vendeur)
// ---------------------------------------------------------------------------

model SellerProfile {
  id                   String       @id @default(cuid())
  userId               String       @unique
  displayName          String
  slug                 String       @unique
  bio                  String?      @db.Text
  avatarUrl            String?
  status               SellerStatus @default(ACTIVE)
  commissionRateBps    Int?
  payoutMobileNumber   String?
  payoutMobileOperator String?
  payoutBankDetails    String?      @db.Text
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  products Product[]
  items    OrderItem[]
  payouts  Payout[]
}

// ---------------------------------------------------------------------------
// CATALOGUE : catégories et livres / guides PDF (Product = "Book")
// ---------------------------------------------------------------------------

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  createdAt   DateTime @default(now())

  products Product[]
}

model Product {
  id            String        @id @default(cuid())
  sellerId      String
  categoryId    String?
  title         String
  slug          String        @unique
  description   String        @db.Text
  language      String        @default("fr")
  pageCount     Int?
  priceAmount   Int
  currency      Currency      @default(XOF)
  coverImageUrl String?
  pdfStorageKey String
  pdfFileName   String
  pdfSizeBytes  Int
  status        ProductStatus @default(PUBLISHED)
  publishedAt   DateTime      @default(now())
  salesCount    Int           @default(0)
  ratingAverage Float         @default(0)
  ratingCount   Int           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  seller      SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  category    Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  orderItems  OrderItem[]
  reviews     Review[]
  favoritedBy Favorite[]

  @@index([sellerId])
  @@index([categoryId])
}

// ---------------------------------------------------------------------------
// PUBLICITÉS
// ---------------------------------------------------------------------------

model Ad {
  id              String      @id @default(cuid())
  placement       AdPlacement
  kind            AdKind
  isActive        Boolean     @default(true)
  priority        Int         @default(0)
  advertiserName  String?
  advertiserEmail String?
  advertiserPhone String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

// ---------------------------------------------------------------------------
// COMMANDES ET LOGISTIQUE TRANSACTIONNELLE
// ---------------------------------------------------------------------------

model Order {
  id        String      @id @default(cuid())
  userId    String
  status    OrderStatus @default(PENDING)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  items OrderItem[]
}

model OrderItem {
  id              String @id @default(cuid())
  orderId         String
  productId       String
  sellerProfileId String

  order         Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  sellerProfile SellerProfile @relation(fields: [sellerProfileId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// TRANSACTIONS ET PAIEMENTS
// ---------------------------------------------------------------------------

model Payout {
  id              String       @id @default(cuid())
  sellerProfileId String
  status          PayoutStatus @default(PENDING)
  createdAt       DateTime     @default(now())

  seller SellerProfile @relation(fields: [sellerProfileId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// SUPPORT ET MESSAGERIE CLIENT
// ---------------------------------------------------------------------------

model SupportThread {
  id         String          @id @default(cuid())
  ownerId    String
  assigneeId String?
  status     ThreadStatus    @default(OPEN)
  createdAt  DateTime        @default(now())

  owner    User      @relation("ThreadOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  assignee User?     @relation("ThreadAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  messages Message[]
}

model Message {
  id       String   @id @default(cuid())
  threadId String
  senderId String
  content  String   @db.Text
  sentAt   DateTime @default(now())

  thread SupportThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender User          @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
}

model ContactMessage {
  id        String        @id @default(cuid())
  userId    String?
  name      String
  email     String
  message   String        @db.Text
  status    ContactStatus @default(NEW)
