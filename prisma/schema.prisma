// prisma/schema.prisma
// TechLibrairie - Schéma de base de données (PostgreSQL / Neon)
// La connexion est lue uniquement depuis la variable d'environnement DATABASE_URL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// ENUMS
// ---------------------------------------------------------------------------

enum Role {
  BUYER
  SELLER
  ADMIN
}

enum SellerStatus {
  ACTIVE
  SUSPENDED
}

enum ProductStatus {
  PUBLISHED
  UNPUBLISHED
  SUSPENDED
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  CANCELED
  REFUNDED
}

enum PaymentProvider {
  STRIPE
  CINETPAY
}

enum PaymentMethod {
  CARD
  MOBILE_MONEY
  ORANGE_MONEY
  MOOV_MONEY
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELED
  REFUNDED
}

enum PayoutStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
}

enum Currency {
  XOF
  EUR
  USD
}

enum SupportCategory {
  GENERAL
  TECHNICAL
  PAYMENT
  SELLER_ACCOUNT
  OTHER
}

enum ThreadStatus {
  AWAITING_PAYMENT
  OPEN
  ANSWERED
  CLOSED
}

enum ContactStatus {
  NEW
  READ
  ANSWERED
  ARCHIVED
}

enum AdPlacement {
  HOME_TOP
  HOME_MIDDLE
  HOME_BOTTOM
  CATALOGUE_TOP
  CATALOGUE_SIDEBAR
  BOOK_PAGE
  SELLER_DASHBOARD
  DOWNLOAD_CONFIRMATION
  FOOTER_TOP
}

enum AdKind {
  LOCAL_BANNER
  ADSTERRA_BANNER
  ADSTERRA_NATIVE
  ADSTERRA_SCRIPT
  ADSTERRA_DIRECT_LINK
  ADSTERRA_POPUNDER
}

// ---------------------------------------------------------------------------
// UTILISATEURS & AUTHENTIFICATION (compatible Auth.js)
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String?
  image         String?
  phone         String?
  role          Role      @default(BUYER)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts        Account[]
  sessions        Session[]
  sellerProfile   SellerProfile?
  orders          Order[]
  supportThreads  SupportThread[] @relation("ThreadOwner")
  assignedThreads SupportThread[] @relation("ThreadAssignee")
  sentMessages    Message[]       @relation("MessageSender")
  contactMessages ContactMessage[]

  @@index([role])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// VENDEURS : auteurs et éditeurs (profil public du vendeur)
// ---------------------------------------------------------------------------

model SellerProfile {
  id                   String       @id @default(cuid())
  userId               String       @unique
  displayName          String
  slug                 String       @unique
  bio                  String?      @db.Text
  avatarUrl            String?
  status               SellerStatus @default(ACTIVE)

  // Taux de commission spécifique à ce vendeur (en points de base, 1000 = 10 %).
  // Si null, le taux global de PlatformSetting s'applique.
  commissionRateBps    Int?

  // Coordonnées de versement des revenus (Orange Money, Moov Money, banque)
  payoutMobileNumber   String?
  payoutMobileOperator String?
  payoutBankDetails    String?      @db.Text

  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  products Product[]
  items    OrderItem[]
  payouts  Payout[]
}

// ---------------------------------------------------------------------------
// CATALOGUE : catégories et livres / guides PDF (Product = "Book")
// ---------------------------------------------------------------------------

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  createdAt   DateTime @default(now())

  products Product[]
}

model Product {
  id            String        @id @default(cuid())
  sellerId      String
  categoryId    String?
  title         String
  slug          String        @unique
  description   String        @db.Text
  language      String        @default("fr")
  pageCount     Int?

  // Règle métier : les prix sont fixés en FCFA (XOF), sans taxe.
  // XOF : francs entiers (multiples de 5 pour Mobile Money).
  priceAmount   Int
  currency      Currency      @default(XOF)

  coverImageUrl String?

  // Fichier PDF stocké en accès PRIVÉ. Jamais exposé publiquement.
  pdfStorageKey String
  pdfFileName   String
  pdfSizeBytes  Int

  // Publication automatique dès la soumission par le vendeur
  status        ProductStatus @default(PUBLISHED)
  publishedAt   DateTime      @default(now())

  salesCount    Int           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  seller   SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  category Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  items    OrderItem[]

  @@index([sellerId])
  @@index([categoryId])
  @@index([status, publishedAt])
}

// ---------------------------------------------------------------------------
// COMMANDES (aucune taxe sur les produits numériques)
// ---------------------------------------------------------------------------

model Order {
  id          String      @id @default(cuid())
  number      String      @unique
  buyerId     String
  buyerEmail  String
  status      OrderStatus @default(PENDING)

  // Total de référence = somme des lignes (en FCFA). Aucune taxe ajoutée.
  totalAmount Int
  currency    Currency

  paidAt      DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  buyer    User        @relation(fields: [buyerId], references: [id], onDelete: Restrict)
  items    OrderItem[]
  payments Payment[]

  @@index([buyerId])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id                String   @id @default(cuid())
  orderId           String
  productId         String
  sellerId          String

  // Instantané du produit au moment de l'achat
  productTitle      String
  unitAmount        Int
  currency          Currency

  // Répartition calculée automatiquement à la vente
  commissionRateBps Int
  commissionAmount  Int
  sellerAmount      Int

  createdAt         DateTime @default(now())

  order     Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  seller    SellerProfile   @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  downloads DownloadToken[]

  @@unique([orderId, productId])
  @@index([sellerId])
  @@index([productId])
}

// ---------------------------------------------------------------------------
// PAIEMENTS (CinetPay : Orange Money / Moov Money ; Stripe : cartes bancaires)
// ---------------------------------------------------------------------------

model Payment {
  id                String          @id @default(cuid())
  orderId           String
  provider          PaymentProvider
  method            PaymentMethod
  status            PaymentStatus   @default(PENDING)

  // Montant réellement débité, dans la devise du paiement
  // (XOF pour le Mobile Money ; EUR/USD en centimes pour la carte convertie).
  amount            Int
  currency          Currency

  // Conversion : montant de référence en FCFA et taux appliqué
  // (nombre de FCFA pour 1 unité de la devise de paiement). Null si paiement en FCFA.
  baseAmountXof     Int?
  exchangeRate      Decimal?        @db.Decimal(18, 6)

  // Identifiant de la transaction chez le prestataire
  // (Stripe : session ; CinetPay : transaction_id)
  providerReference String          @unique
  providerPayload   Json?

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([status])
}

// Taux de change pour convertir les prix en FCFA vers les devises internationales.
// L'historique est conservé ; le taux actif le plus récent est utilisé.
model ExchangeRate {
  id          String   @id @default(cuid())
  currency    Currency
  // Nombre de FCFA pour 1 unité de la devise (ex. EUR : 655.957000)
  xofPerUnit  Decimal  @db.Decimal(18, 6)
  source      String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([currency, isActive, createdAt])
}

// ---------------------------------------------------------------------------
// TÉLÉCHARGEMENT SÉCURISÉ
// ---------------------------------------------------------------------------

model DownloadToken {
  id            String    @id @default(cuid())
  orderItemId   String
  token         String    @unique
  expiresAt     DateTime
  maxDownloads  Int       @default(5)
  downloadCount Int       @default(0)
  lastUsedAt    DateTime?
  createdAt     DateTime  @default(now())

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([orderItemId])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// VERSEMENTS AUX VENDEURS
// ---------------------------------------------------------------------------

model Payout {
  id          String       @id @default(cuid())
  sellerId    String
  amount      Int
  currency    Currency
  status      PayoutStatus @default(PENDING)
  method      String?
  reference   String?
  note        String?
  requestedAt DateTime     @default(now())
  paidAt      DateTime?

  seller SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Restrict)

  @@index([sellerId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// MESSAGERIE MONÉTISÉE : support payant en FCFA avec la plateforme
// ---------------------------------------------------------------------------

model SupportThread {
  id            String          @id @default(cuid())
  number        String          @unique
  userId        String
  subject       String
  category      SupportCategory @default(GENERAL)
  status        ThreadStatus    @default(AWAITING_PAYMENT)

  // Tarif du support en FCFA, figé à la création de la conversation
  feeAmountXof  Int
  paidAt        DateTime?

  // Membre de l'équipe (administrateur) qui répond
  assignedToId  String?

  lastMessageAt DateTime        @default(now())
  closedAt      DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  user       User             @relation("ThreadOwner", fields: [userId], references: [id], onDelete: Cascade)
  assignedTo User?            @relation("ThreadAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  messages   Message[]
  payments   SupportPayment[]

  @@index([userId])
  @@index([assignedToId])
  @@index([status, lastMessageAt])
}

model Message {
  id        String    @id @default(cuid())
  threadId  String
  senderId  String
  // true si le message vient de l'équipe de la plateforme
  isStaff   Boolean   @default(false)
  body      String    @db.Text
  readAt    DateTime?
  createdAt DateTime  @default(now())

  thread SupportThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender User          @relation("MessageSender", fields: [senderId], references: [id], onDelete: Restrict)

  @@index([threadId, createdAt])
  @@index([senderId])
}

// Paiement du support (mêmes passerelles que les commandes)
model SupportPayment {
  id                String          @id @default(cuid())
  threadId          String
  provider          PaymentProvider
  method            PaymentMethod
  status            PaymentStatus   @default(PENDING)
  amount            Int
  currency          Currency
  baseAmountXof     Int
  exchangeRate      Decimal?        @db.Decimal(18, 6)
  providerReference String          @unique
  providerPayload   Json?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  thread SupportThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId])
  @@index([status])
}

// Messages envoyés depuis le formulaire de contact du pied de page (gratuit, public)
model ContactMessage {
  id        String        @id @default(cuid())
  userId    String?
  name      String
  email     String
  phone     String?
  subject   String
  message   String        @db.Text
  status    ContactStatus @default(NEW)
  // Empreinte de l'adresse IP (jamais l'IP en clair) pour limiter le spam
  ipHash    String?
  createdAt DateTime      @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([ipHash, createdAt])
}

// ---------------------------------------------------------------------------
// ESPACES PUBLICITAIRES : bannières locales et emplacements Adsterra
// ---------------------------------------------------------------------------

model AdSpace {
  id              String      @id @default(cuid())
  name            String
  placement       AdPlacement
  kind            AdKind
  isActive        Boolean     @default(true)
  // Plus la valeur est élevée, plus l'annonce est prioritaire dans l'emplacement
  priority        Int         @default(0)

  // Bannière locale (entreprise tierce)
  advertiserName  String?
  advertiserEmail String?
  advertiserPhone String?
  imageUrl        String?
  targetUrl       String?
  altText         String?

  // Contrat publicitaire (prix payé par l'annonceur, en FCFA)
  priceAmountXof  Int?
  startsAt        DateTime?
  endsAt          DateTime?

  // Statistiques
  impressions     Int         @default(0)
  clicks          Int         @default(0)

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([placement, isActive, priority])
  @@index([endsAt])
}

// ---------------------------------------------------------------------------
// PARAMÈTRES GLOBAUX DE LA PLATEFORME (une seule ligne, id = "global")
// ---------------------------------------------------------------------------

model PlatformSetting {
  id                       String   @id @default("global")

  // Commission par défaut en points de base (1000 = 10 %)
  defaultCommissionRateBps Int      @default(1000)

  // Téléchargement sécurisé
  downloadLinkTtlHours     Int      @default(72)
  downloadMaxAttempts      Int      @default(5)

  // Montant minimal pour demander un versement (en XOF)
  minPayoutAmountXof       Int      @default(5000)

  // Marge appliquée lors de la conversion FCFA vers une devise étrangère
  // (en points de base, 200 = 2 %), pour absorber les variations de change
  fxMarginBps              Int      @default(200)

  // Tarif par défaut d'une conversation de support (en FCFA)
  supportFeeXof            Int      @default(1000)

  // Coordonnées affichées dans le pied de page
  contactEmail             String?
  whatsappNumber           String?

  updatedAt                DateTime @updatedAt
}
