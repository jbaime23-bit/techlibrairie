// prisma/schema.prisma
// TechLibrairie - Schéma de base de données (PostgreSQL / Neon)
// La connexion est lue uniquement depuis la variable d'environnement DATABASE_URL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// ENUMS
// ---------------------------------------------------------------------------

enum Role {
  BUYER
  SELLER
  ADMIN
}

enum SellerStatus {
  ACTIVE
  SUSPENDED
}

enum ProductStatus {
  PUBLISHED
  UNPUBLISHED
  SUSPENDED
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  CANCELED
  REFUNDED
}

enum PaymentProvider {
  STRIPE
  CINETPAY
}

enum PaymentMethod {
  CARD
  MOBILE_MONEY
  ORANGE_MONEY
  MOOV_MONEY
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELED
  REFUNDED
}

enum PayoutStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
}

enum Currency {
  XOF
  EUR
  USD
}

enum SupportCategory {
  GENERAL
  TECHNICAL
  PAYMENT
  SELLER_ACCOUNT
  OTHER
}

enum ThreadStatus {
  AWAITING_PAYMENT
  OPEN
  ANSWERED
  CLOSED
}

enum ContactStatus {
  NEW
  READ
  ANSWERED
  ARCHIVED
}

enum AdPlacement {
  HOME_TOP
  HOME_MIDDLE
  HOME_BOTTOM
  CATALOGUE_TOP
  CATALOGUE_SIDEBAR
  BOOK_PAGE
  SELLER_DASHBOARD
  DOWNLOAD_CONFIRMATION
  FOOTER_TOP
}

enum AdKind {
  LOCAL_BANNER
  ADSTERRA_BANNER
  ADSTERRA_NATIVE
  ADSTERRA_SCRIPT
  ADSTERRA_DIRECT_LINK
  ADSTERRA_POPUNDER
}

// ---------------------------------------------------------------------------
// UTILISATEURS & AUTHENTIFICATION (compatible Auth.js)
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String?
  passwordChangedAt DateTime?
  image         String?
  phone         String?
  role          Role      @default(BUYER)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts        Account[]
  sessions        Session[]
  sellerProfile   SellerProfile?
  orders          Order[]
  supportThreads  SupportThread[] @relation("ThreadOwner")
  assignedThreads SupportThread[] @relation("ThreadAssignee")
  sentMessages    Message[]       @relation("MessageSender")
  contactMessages ContactMessage[]

  @@index([role])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  ipHash    String?
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ipHash, createdAt])
}

// ---------------------------------------------------------------------------
// VENDEURS : auteurs et éditeurs (profil public du vendeur)
// ---------------------------------------------------------------------------

model SellerProfile {
  id                   String       @id @default(cuid())
  userId               String       @unique
  displayName          String
  slug                 String       @unique
  bio                  String?      @db.Text
  avatarUrl            String?
  status               SellerStatus @default(ACTIVE)
  commissionRateBps    Int?
  payoutMobileNumber   String?
  payoutMobileOperator String?
  payoutBankDetails    String?      @db.Text
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  products Product[]
  items    OrderItem[]
  payouts  Payout[]
}

// ---------------------------------------------------------------------------
// CATALOGUE : catégories et livres / guides PDF (Product = "Book")
// ---------------------------------------------------------------------------

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  createdAt   DateTime @default(now())

  products Product[]
}

model Product {
  id            String        @id @default(cuid())
  sellerId      String
  categoryId    String?
  title         String
  slug          String        @unique
  description   String        @db.Text
  language      String        @default("fr")
  pageCount     Int?
  priceAmount   Int
  currency      Currency      @default(XOF)
  coverImageUrl String?
  pdfStorageKey String
  pdfFileName   String
  pdfSizeBytes  Int
  status        ProductStatus @default(PUBLISHED)
  publishedAt   DateTime      @default(now())
  salesCount    Int           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  seller   SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  category Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  items    OrderItem[]

  @@index([sellerId])
  @@index([categoryId])
  @@index([status, publishedAt])
}

// ---------------------------------------------------------------------------
// COMMANDES (aucune taxe sur les produits numériques)
// ---------------------------------------------------------------------------

model Order {
  id          String      @id @default(cuid())
  number      String      @unique
  buyerId     String
  buyerEmail  String
  status      OrderStatus @default(PENDING)
  totalAmount Int
  currency    Currency
  paidAt      DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  buyer    User        @relation(fields: [buyerId], references: [id], onDelete: Restrict)
  items    OrderItem[]
  payments Payment[]

  @@index([buyerId])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id                String   @id @default(cuid())
  orderId           String
  productId         String
  sellerId          String
  productTitle      String
  unitAmount        Int
  currency          Currency
  commissionRateBps Int
  commissionAmount  Int
  sellerAmount      Int
  createdAt         DateTime @default(now())

  order     Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  seller    SellerProfile   @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  downloads DownloadToken[]

  @@unique([orderId, productId])
  @@index([sellerId])
  @@index([productId])
}

// ---------------------------------------------------------------------------
// PAIEMENTS & REVERSEMENTS
// ---------------------------------------------------------------------------

model Payment {
  id            String          @id @default(cuid())
  orderId       String
  provider      PaymentProvider
  method        PaymentMethod
  status        PaymentStatus   @default(PENDING)
  amount        Int
  currency      Currency        @default(XOF)
  transactionId String?         @unique
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model Payout {
  id            String       @id @default(cuid())
  sellerId      String
  amount        Int
  currency      Currency     @default(XOF)
  status        PayoutStatus @default(PENDING)
  payoutMethod  String
  transactionId String?      @unique
  paidAt        DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  seller SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Restrict)

  @@index([sellerId])
}

// ---------------------------------------------------------------------------
// JETONS DE TÉLÉCHARGEMENT SÉCURISÉS (Accès limité)
// ---------------------------------------------------------------------------

model DownloadToken {
  id          String   @id @default(cuid())
  orderItemId String
  token       String   @unique
  usesCount   Int      @default(0)
  maxUses     Int      @default(2)
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([orderItemId])
}

// ---------------------------------------------------------------------------
// SUPPORT CLIENTELE & MESSAGERIE
// ---------------------------------------------------------------------------

model SupportThread {
  id         String          @id @default(cuid())
  ownerId    String
  assigneeId String?
  subject    String
  category   SupportCategory @default(GENERAL)
  status     ThreadStatus    @default(OPEN)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  owner    User      @relation("ThreadOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  assignee User?     @relation("ThreadAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  messages Message[]

  @@index([ownerId])
  @@index([assigneeId])
  @@index([status])
}

model Message {  id        String   @id @default(cuid())
  threadId  String
  senderId  String
  content   String   @db.Text
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  thread SupportThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender User          @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([threadId])
  @@index([senderId])
}

model ContactMessage {
  id        String        @id @default(cuid())
  userId    String?
  name      String
  email     String
  subject   String
  message   String        @db.Text
  status    ContactStatus @default(NEW)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
}
