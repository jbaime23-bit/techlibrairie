# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Base de données PostgreSQL (Neon)
# Seule DATABASE_URL est nécessaire.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://utilisateur:motdepasse@hote:5432/techlibrairie?sslmode=require"

# ---------------------------------------------------------------------------
# Authentification (Auth.js / NextAuth)
# Générer le secret avec : openssl rand -base64 32
# ---------------------------------------------------------------------------
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="remplacez-par-un-secret-long-et-aleatoire"

# ---------------------------------------------------------------------------
# Initialisation de la plateforme (page /initialisation)
# Code secret d'au moins 16 caractères, à saisir dans le formulaire.
# La page se verrouille dès qu'un administrateur existe.
# ---------------------------------------------------------------------------
SETUP_SECRET="remplacez-par-un-code-secret-d-au-moins-16-caracteres"

# ---------------------------------------------------------------------------
# Coordonnées du pied de page (facultatif : peuvent aussi être saisies
# à l'initialisation, puis modifiées dans l'espace administrateur)
# WhatsApp : numéro au format international, chiffres uniquement (ex. 22670000000)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_CONTACT_EMAIL="contact@techlibrairie.com"
NEXT_PUBLIC_WHATSAPP_NUMBER="22670000000"

# ---------------------------------------------------------------------------
# Compte administrateur du script terminal (npm run db:seed) - facultatif
# ---------------------------------------------------------------------------
ADMIN_EMAIL="admin@techlibrairie.com"
ADMIN_PASSWORD="remplacez-par-un-mot-de-passe-fort"

# ---------------------------------------------------------------------------
# Stockage Vercel Blob
# 1) Store PRIVÉ (PDF des livres) : variable par défaut du SDK
# 2) Store PUBLIC (couvertures et bannières)
# ---------------------------------------------------------------------------
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_token_du_store_prive"
BLOB_PUBLIC_READ_WRITE_TOKEN="vercel_blob_rw_token_du_store_public"

# ---------------------------------------------------------------------------
# Paiements internationaux : Stripe (cartes Visa / MasterCard)
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxx"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_xxxxxxxxxxxxxxxx"
STRIPE_WEBHOOK_SECRET="whsec_xxxxxxxxxxxxxxxx"

# ---------------------------------------------------------------------------
# Paiements locaux : CinetPay (Orange Money, Moov Money - Burkina Faso)
# ---------------------------------------------------------------------------
CINETPAY_API_KEY="votre_api_key_cinetpay"
CINETPAY_SITE_ID="votre_site_id_cinetpay"
CINETPAY_SECRET_KEY="votre_secret_key_cinetpay"
